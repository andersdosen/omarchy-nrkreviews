#!/usr/bin/env bash
# Fetches NRK's own review-listing endpoint to stdout under a hard byte cap,
# with a response-status and content-type check, before any of the body
# ever reaches Panel.qml's JSON.parse. Mirrors fetch-poster/fetch-suggest's
# approach in the sibling andersdosen.imdbsearch plugin to the same problem.
set -uo pipefail

max_bytes=262144      # a 10-item page runs ~20-45KB in practice; generous headroom
timeout=8
host_re='^https://www\.nrk\.no/komponenter/api/autonomous-content/plugs\.json\?'

usage() { echo "usage: $(basename "$0") <url>" >&2; exit 2; }
[[ $# -eq 1 ]] || usage
url=$1

if ! [[ "$url" =~ $host_re ]]; then
  echo "fetch-reviews: refusing untrusted host: $url" >&2
  exit 1
fi

tmp=$(mktemp)
header_file=$(mktemp)
cleanup() { rm -f "$tmp" "$header_file"; }
trap cleanup EXIT

# --max-filesize is checked by curl against the transfer as it arrives on
# the wire — i.e. still-compressed bytes when --compressed is in play, or
# a declared Content-Length that likewise describes the compressed size.
# It does NOT bound the decoded size, so a malicious response can still
# gzip-expand into something far larger than max_bytes by the time it
# reaches disk. --max-filesize is kept only as a cheap early-abort when
# the server declares a huge size upfront; the actual cap on decoded
# bytes written to $tmp is `head -c`, below, which truncates the decoded
# stream itself regardless of compression ratio — bounding disk/tmpfs
# usage to max_bytes+1 no matter how much the response inflates.
# -D writes response headers to $header_file; -o is not used here because
# the body must flow through the pipe into head, not straight to a file.
# Redirects are not followed (no -L): the URL is built entirely from a
# fixed, known host, so a redirect response is simply rejected below by
# the status check.
curl -sS \
  --compressed \
  --max-time "$timeout" \
  --max-filesize "$max_bytes" \
  -D "$header_file" \
  "$url" | head -c $((max_bytes + 1)) >"$tmp"
status=${PIPESTATUS[0]}

if [[ $status -ne 0 ]]; then
  echo "fetch-reviews: curl failed (exit $status)" >&2
  exit 1
fi

headers=$(tr -d '\r' <"$header_file")

code=$(printf '%s\n' "$headers" | awk 'NR==1{print $2}')
if [[ "$code" != "200" ]]; then
  echo "fetch-reviews: unexpected HTTP status: $code" >&2
  exit 1
fi

content_type=$(printf '%s\n' "$headers" | awk -F': ' 'tolower($1)=="content-type"{print tolower($2); exit}')
case "$content_type" in
  application/json*) ;;
  *)
    echo "fetch-reviews: unexpected content-type: $content_type" >&2
    exit 1
    ;;
esac

# Belt-and-suspenders check on the actual bytes written. head's own cap
# above already bounds this to max_bytes+1 at most, so this just confirms
# the stream wasn't truncated mid-cap (i.e. the real body fit).
size=$(stat -c%s "$tmp" 2>/dev/null || wc -c <"$tmp")
if (( size > max_bytes )); then
  echo "fetch-reviews: response exceeded byte cap" >&2
  exit 1
fi

cat "$tmp"
